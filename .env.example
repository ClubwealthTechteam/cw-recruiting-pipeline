# Copy into Vercel > Project > Settings > Environment Variables. Never commit real values.
# One access code per person, as JSON (same format as the Admin Hub). Names: Miguel, Camille, Am.
ACCESS_CODES={"Miguel":"CW-XXXX-XXXX","Camille":"CW-XXXX-XXXX","Am":"CW-XXXX-XXXX"}
# Long random string used to sign the login cookie.
SESSION_SECRET=
# Apps Script web app URL (Deploy > Manage deployments) and the API_SECRET script property.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
# Chat bubble: the "Recruiting – chat bubble" routine's ID (trig_...) and its API trigger token (claude.ai → Routines → the routine → Trigger → API → Generate token).
CHAT_ROUTINE_ID=
CHAT_ROUTINE_TOKEN=
