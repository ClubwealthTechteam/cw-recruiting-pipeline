# Copy into Vercel > Project > Settings > Environment Variables. Never commit real values.
# One access code per person: Name=code, comma separated. Names must be Miguel, Camille, Am.
ACCESS_CODES=Miguel=change-me,Camille=change-me,Am=change-me
# Long random string used to sign the login cookie.
SESSION_SECRET=
# Apps Script web app URL (Deploy > Manage deployments) and the API_SECRET script property.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
